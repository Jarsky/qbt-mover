# Non-secret settings. Credentials go in secrets.env.

# qBittorrent Web UI
QBT_ADDR=http://qbittorrent:8080

# Unraid host
REMOTE_HOST=root@tower

# SSH private key on the Docker host (chmod 600)
SSH_KEY_PATH=~/.ssh/id_ed25519

# Docker network that can reach qBittorrent
DOCKER_NETWORK=mynetwork

# Cron schedules, in the container's time zone
TZ=UTC
CRON_SCHEDULE_PAUSE=0 3 * * *
CRON_SCHEDULE_RESUME=*/15 * * * *

# What gets force-started:
#   restore  only torrents that were force-started before the pause (default)
#   running  every torrent the pause stopped: running, forced or queued
#   all      every torrent in qBittorrent, on every scheduled run
FORCE_START_MODE=restore
