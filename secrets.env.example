# Copy to secrets.env and run: chmod 600 secrets.env
# Values are taken literally up to the end of the line, so don't add quotes.

# qBittorrent Web UI. Leave both empty if qBittorrent doesn't ask this container to log in.
QBT_LOGIN=
QBT_PASSWORD=

# Passphrase for the SSH key. Leave empty if the key has none.
SSH_KEY_PASSPHRASE=
